# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# Développement — SQLite, aucune installation requise.
DATABASE_URL="file:./prisma/dev.db"

# Production — PostgreSQL.
#   1. npm run db:use:postgres     (bascule le provider Prisma et régénère le client)
#   2. remplacer la ligne ci-dessus par l'URL de connexion :
# DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/muscu"
#
# En conteneur (Docker / Coolify), le Dockerfile bascule le provider tout seul :
# il suffit de fournir DATABASE_URL.

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------
# Secret de signature des sessions — OBLIGATOIRE, 32 caractères minimum.
# Générer avec :  openssl rand -base64 32
AUTH_SECRET="remplacez-moi-par-une-chaine-aleatoire-de-32-caracteres-minimum"

# ---------------------------------------------------------------------------
# Facultatif
# ---------------------------------------------------------------------------
# Email du compte administrateur (accès à /admin).
ADMIN_EMAIL="demo@muscu.app"

# Derrière un reverse proxy, si les formulaires renvoient
# « Invalid Server Actions request », déclarer ici le domaine public
# (sans https://, plusieurs valeurs séparées par des virgules).
# ALLOWED_ORIGINS="muscu.mondomaine.be"

# Mettre à 0 pour ne pas appliquer les migrations au démarrage du conteneur.
# RUN_MIGRATIONS=1
